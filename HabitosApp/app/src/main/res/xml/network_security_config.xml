<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">

        <!--
            EMULADOR ANDROID (configuración actual):
            10.0.2.2 es el alias especial que el emulador usa para
            referirse al localhost del PC donde corre el backend.
        -->
        <domain includeSubdomains="false">10.0.2.2</domain>

        <!--
            DISPOSITIVO FÍSICO (descomentar cuando sea necesario):
            Reemplazar con la IP local del PC en la red WiFi.
            El PC y el dispositivo deben estar en la misma red.

            <domain includeSubdomains="false">192.168.1.105</domain>
        -->

    </domain-config>
</network-security-config>